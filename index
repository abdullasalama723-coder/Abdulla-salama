<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>SHUBRA ENG VAULT — منصة هندسة شبرا</title>
<style>
:root{--bg:#f4f6fa;--card:#fff;--tx:#14213d;--mut:#5b6785;--ac:#f59e0b;--ac2:#1d4ed8;--bd:#dbe1ee;--ok:#16a34a;--bad:#dc2626;box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){--bg:#0b1426;--card:#142038;--tx:#eaf0ff;--mut:#9fb0d3;--bd:#24345a;--ac2:#60a5fa}}
:root[data-theme="dark"]{--bg:#0b1426;--card:#142038;--tx:#eaf0ff;--mut:#9fb0d3;--bd:#24345a;--ac2:#60a5fa}
*{box-sizing:border-box}html{scroll-padding-top:env(safe-area-inset-top,0px)}
body{margin:0;background:var(--bg);color:var(--tx);font-family:"Segoe UI",Tahoma,"Noto Naskh Arabic",Arial,sans-serif;min-height:100vh}
.scr{display:none;max-width:560px;margin:0 auto;padding:18px}.scr.on{display:block}
h1,h2{margin:0}.logo{font-weight:800;font-size:22px;text-align:center;letter-spacing:.5px}.sub{color:var(--mut);text-align:center;margin:6px 0 20px;font-size:14px}
.box{background:var(--card);border:1px solid var(--bd);border-radius:16px;padding:18px;margin-bottom:14px}
input,textarea{width:100%;padding:12px;border-radius:10px;border:1px solid var(--bd);background:var(--bg);color:var(--tx);font:inherit}
button{font:inherit;cursor:pointer;border:0;border-radius:10px;padding:11px 16px;background:var(--ac);color:#1a1200;font-weight:700}
button.g{background:transparent;color:var(--tx);border:1px solid var(--bd)}button.b{background:var(--ac2);color:#fff}
button.ok{background:var(--ok);color:#fff}button.bad{background:var(--bad);color:#fff}
.row{display:flex;gap:8px;flex-wrap:wrap;align-items:center}.row>*{flex:1}
.top{display:flex;justify-content:space-between;align-items:center;margin-bottom:14px;gap:8px}.top button{flex:none;padding:8px 12px}
.grid{display:grid;grid-template-columns:1fr 1fr;gap:12px}
.sj{background:var(--card);border:1px solid var(--bd);border-radius:16px;padding:16px;text-align:center;cursor:pointer}
.sj .e{font-size:34px}.sj b{display:block;margin:6px 0;font-size:17px}.sj small{color:var(--mut)}
.bar{height:7px;background:var(--bd);border-radius:9px;overflow:hidden;margin-top:8px}.bar i{display:block;height:100%;background:var(--ac)}
.tabs{display:flex;gap:8px;margin-bottom:14px}.tabs button{flex:1;background:transparent;color:var(--tx);border:1px solid var(--bd)}.tabs button.on{background:var(--ac2);color:#fff;border-color:var(--ac2)}
.fc{min-height:170px;display:flex;align-items:center;justify-content:center;text-align:center;font-size:20px;font-weight:700;cursor:pointer;direction:rtl;line-height:1.7}
.fc.back{color:var(--ac2)}.hint{color:var(--mut);font-size:13px;text-align:center;margin:8px 0}
.op{display:block;width:100%;text-align:right;margin:8px 0;background:var(--bg);color:var(--tx);border:1px solid var(--bd);font-weight:500;direction:rtl}
.op.c{background:var(--ok);color:#fff}.op.w{background:var(--bad);color:#fff}
.modal{position:fixed;inset:0;background:rgba(0,0,0,.55);display:none;align-items:center;justify-content:center;padding:18px;z-index:20}.modal.on{display:flex}
.modal .box{width:100%;max-width:440px;max-height:90vh;overflow:auto;margin:0}
label.sw{display:flex;justify-content:space-between;align-items:center;margin:10px 0}
.big{font-size:44px;text-align:center}.ltr{direction:ltr;unicode-bidi:isolate}
.hero{display:flex;align-items:center;gap:16px}
.fc{animation:pop .25s ease}@keyframes pop{from{opacity:.3;transform:scale(.96)}to{opacity:1;transform:none}}
.scr.on{animation:fade .3s ease}@keyframes fade{from{opacity:0;transform:translateY(6px)}to{opacity:1;transform:none}}
.ex{background:var(--bg);border:1px solid var(--bd);border-radius:10px;padding:10px;margin-top:8px;font-size:14px;line-height:1.7}
.ri{border-bottom:1px solid var(--bd);padding:10px 0;line-height:1.7}.ri:last-of-type{border:0}
.sj{transition:transform .15s}.sj:active{transform:scale(.97)}.tabs button{padding:10px 6px}
@media(prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}}
</style>
</head>
<body>

<section class="scr" id="reg">
<div class="big" style="margin-top:40px">📐</div>
<div class="logo">⚙️ SHUBRA ENG VAULT 🏗️</div>
<div class="sub">منصة مذاكرة طلاب كلية الهندسة بشبرا</div>
<div class="box"><h2 style="font-size:18px;margin-bottom:6px">أنشئ حسابك</h2>
<p class="sub" style="text-align:right;margin:0 0 12px">اكتب اسمك مرة واحدة فقط. يبقى محفوظًا على هذا الجهاز.</p>
<input id="nm" placeholder="اسم المستخدم" maxlength="30">
<button class="b" style="width:100%;margin-top:12px" onclick="reg()">إنشاء الحساب</button>
<p class="sub" style="margin:12px 0 0;font-size:12px">بياناتك تبقى في هذا المتصفح فقط ولا تُرسل إلى أي مكان.</p></div>
</section>

<section class="scr" id="wel">
<div class="big" style="margin-top:60px">🎓</div>
<div class="logo">مرحبًا بك يا م. <span id="wn"></span></div>
<div class="sub">في SHUBRA ENG VAULT<br>فيزياء • استاتيكا • كيمياء • ماث</div>
<button class="b" style="width:100%" onclick="show('home')">ابدأ</button>
</section>

<section class="scr" id="home">
<div class="top"><div><div class="logo" style="text-align:right;font-size:18px">⚙️ SHUBRA ENG VAULT</div><div style="color:var(--mut);font-size:13px">اختر المادة — أهلًا <span id="hn"></span></div></div>
<span><button class="g" onclick="openM('upd')">🆕</button> <button class="g" onclick="openM('set')">⚙️ الإعدادات</button></span></div>
<div class="box hero" id="hero"></div>
<div class="grid" id="subs"></div>
</section>

<section class="scr" id="sub">
<div class="top"><button class="g" onclick="show('home')">→ المواد</button><b id="st"></b><span style="width:70px"></span></div>
<div class="tabs"><button id="t1" class="on" onclick="mode('c')">🃏 البطاقات</button><button id="t2" onclick="mode('q')">📝 اختبار</button><button id="t3" onclick="mode('r')">🔁 مراجعة</button></div>
<div class="box" id="pane"></div>
</section>

<div class="modal" id="set"><div class="box">
<h2 style="font-size:18px;margin-bottom:10px">الإعدادات</h2>
<label class="sw">الوضع الليلي / النهاري <button class="g" onclick="toggleTheme()">☀️ / 🌙</button></label>
<label class="sw">إظهار شاشة الترحيب <input type="checkbox" id="wc" style="width:auto" onchange="st.wel=this.checked;save()"></label>
<p class="hint" style="text-align:right">نقل تقدمك: انسخ النص أو الصقه ثم استورده.</p>
<textarea id="ex" rows="3"></textarea>
<div class="row" style="margin-top:8px"><button class="g" onclick="doExp()">📤 تصدير</button><button class="g" onclick="doImp()">📥 استيراد</button></div>
<div class="row" style="margin-top:12px"><button class="bad" onclick="resetAll()">تصفير الحساب</button><button class="g" onclick="closeM('set')">إغلاق</button></div>
</div></div>

<div class="modal" id="upd"><div class="box"><h2 style="font-size:18px;margin-bottom:10px">🆕 التحديثات</h2><div class="ri">🔥 عدّاد أيام المذاكرة وحلقة التقدم الكلي</div><div class="ri">🔁 تبويب مراجعة الأخطاء</div><div class="ri">💡 شرح لكل إجابة في الاختبار</div><div class="ri">📚 بطاقات وأسئلة أكثر في كل مادة</div><button class="g" style="width:100%;margin-top:10px" onclick="closeM('upd')">إغلاق</button></div></div>

<script>
var S=[
{id:'phy',n:'فيزياء',e:'⚛️',
c:[['قانون نيوتن الثاني؟','F = m·a'],['وحدة الشغل؟','الجول J = N·m'],['طاقة الحركة؟','KE = ½ m v²'],['قانون أوم؟','V = I·R']],
q:[['وحدة القدرة؟',['واط','جول','نيوتن','باسكال']],['التسارع الناتج عن قوة 10 N على كتلة 2 kg؟',['5 m/s²','20 m/s²','0.2 m/s²','12 m/s²']],['سرعة الضوء تقريبًا؟',['3×10⁸ m/s','3×10⁶ m/s','3×10⁵ m/s','3×10¹⁰ m/s']]]},
{id:'sta',n:'استاتيكا',e:'🏗️',
c:[['شروط اتزان الجسم في المستوى؟','ΣFx = 0 ، ΣFy = 0 ، ΣM = 0'],['عزم القوة؟','M = F × d (البعد العمودي)'],['مركبتا القوة؟','Fx = F cosθ ، Fy = F sinθ'],['الازدواج؟','قوتان متساويتان متضادتان في الاتجاه وخطا عملهما مختلفان ، عزمه F × d']],
q:[['عدد معادلات الاتزان في المستوى؟',['3','2','6','1']],['المركبة الأفقية لقوة 100 N تميل 30° على الأفقي؟',['86.6 N','50 N','100 N','0 N']],['وحدة العزم؟',['N·m','N','J/s','Pa']]]},
{id:'che',n:'كيمياء',e:'🧪',
c:[['العدد الذري؟','عدد البروتونات في النواة'],['قانون الغاز المثالي؟','PV = nRT'],['المول؟','6.022×10²³ جسيم'],['الأس الهيدروجيني؟','pH = −log[H⁺]']],
q:[['pH المحلول المتعادل عند 25°C؟',['7','0','14','1']],['رمز عنصر الصوديوم؟',['Na','S','So','N']],['نوع الرابطة في NaCl؟',['أيونية','تساهمية','فلزية','هيدروجينية']]]},
{id:'mat',n:'ماث',e:'📐',
c:[['مشتقة xⁿ؟','n·xⁿ⁻¹'],['تكامل xⁿ؟','xⁿ⁺¹ / (n+1) + C'],['متطابقة فيثاغورس المثلثية؟','sin²θ + cos²θ = 1'],['مشتقة sin x؟','cos x']],
q:[['d/dx (eˣ) =',['eˣ','x·eˣ','1','ln x']],['∫ 2x dx =',['x² + C','2x² + C','x + C','2 + C']],['نهاية sin x / x عندما x → 0؟',['1','0','∞','−1']]]}
];
var C=['#3b82f6','#f59e0b','#10b981','#a855f7'],sc=0;
function E(i,a){a.forEach(function(t,k){S[i].q[k][2]=t})}
function X(i,c,q){S[i].c=S[i].c.concat(c);S[i].q=S[i].q.concat(q)}
E(0,['القدرة = الشغل ÷ الزمن = جول/ثانية = واط','a = F / m = 10 ÷ 2 = 5 m/s²','c ≈ 3×10⁸ m/s في الفراغ']);
E(1,['ΣFx = 0 و ΣFy = 0 و ΣM = 0','Fx = F cos30° = 100×0.866 = 86.6 N','M = F×d ووحدتها نيوتن×متر']);
E(2,['pH = 7 يعني [H⁺] = 10⁻⁷ والمحلول متعادل','Na من الاسم اللاتيني Natrium','فلز مع لافلز: انتقال إلكترون فتتكون رابطة أيونية']);
E(3,['مشتقة eˣ تساوي eˣ نفسها','∫ 2x dx = x² + C لأن مشتقة x² هي 2x','نهاية مشهورة: sin x / x → 1']);
X(0,[['قانون نيوتن الأول؟','الجسم الساكن يبقى ساكنًا والمتحرك يبقى بسرعة ثابتة ما لم تؤثر عليه قوة محصلة'],['قانون الجذب العام؟','F = G·m₁·m₂ / r²'],['السرعة المتوسطة؟','v = Δx / Δt'],['معادلات الحركة بعجلة ثابتة؟','v = v₀ + at ، s = v₀t + ½at² ، v² = v₀² + 2as']],[['سقط جسم من السكون لمدة 2 s (g = 10)، سرعته؟',['20 m/s','10 m/s','5 m/s','40 m/s'],'v = g·t = 10×2 = 20 m/s'],['القدرة تساوي؟',['الشغل ÷ الزمن','القوة × الزمن','الكتلة × السرعة','الشغل × الزمن'],'P = W / t'],['مقاومة 10 Ω وتيار 2 A، فرق الجهد؟',['20 V','5 V','12 V','0.2 V'],'V = I·R = 2×10 = 20 V']]);
X(1,[['محصلة قوتين متعامدتين؟','R = √(F₁² + F₂²) ، tanα = F₂ / F₁'],['قاعدة لامي؟','F₁/sinα = F₂/sinβ = F₃/sinγ (لثلاث قوى متلاقية متزنة)'],['قوة الاحتكاك؟','f ≤ μ·N وعند الحد الأقصى f = μ·N'],['مركز ثقل مجموعة أجسام؟','x̄ = Σ(w·x) / Σw']],[['محصلة قوتين 3 N و 4 N متعامدتين؟',['5 N','7 N','1 N','12 N'],'R = √(9 + 16) = 5 N'],['ثقل 20 N على سطح أفقي أملس، رد الفعل العمودي؟',['20 N','0 N','10 N','40 N'],'ΣFy = 0 فالرد يساوي الوزن'],['عزم قوة 50 N على بعد عمودي 0.4 m؟',['20 N·m','125 N·m','2 N·m','50.4 N·m'],'M = 50×0.4 = 20 N·m']]);
X(2,[['قاعدة الثمانيات؟','تميل الذرات للوصول إلى 8 إلكترونات في غلاف التكافؤ'],['التركيز المولاري؟','M = عدد المولات ÷ حجم المحلول باللتر'],['قانون بويل؟','P₁V₁ = P₂V₂ عند ثبوت درجة الحرارة'],['الأكسدة والاختزال؟','الأكسدة فقد إلكترونات والاختزال اكتساب إلكترونات']],[['عدد المولات في 36 g ماء (H₂O = 18)؟',['2 mol','1 mol','4 mol','0.5 mol'],'n = 36 ÷ 18 = 2 mol'],['محلول pH = 3 يكون؟',['حمضي','قاعدي','متعادل','لا يمكن تحديده'],'pH أقل من 7 يعني وسط حمضي'],['في تفاعل الأكسدة الذرة؟',['تفقد إلكترونات','تكتسب إلكترونات','تفقد بروتونات','تكتسب نيوترونات'],'الأكسدة = فقد إلكترونات']]);
X(3,[['مشتقة eˣ؟','eˣ'],['مشتقة ln x؟','1 / x'],['قاعدة الضرب في الاشتقاق؟','(u·v)′ = u′v + uv′'],['مشتقة cos x؟','−sin x']],[['d/dx (3x²) =',['6x','3x','6x²','x³'],'نضرب الأس في المعامل وننقص الأس 1'],['∫ cos x dx =',['sin x + C','−sin x + C','cos x + C','−cos x + C'],'لأن مشتقة sin x هي cos x'],['قيمة sin 90° =',['1','0','−1','½'],'sin 90° = 1']]);
function streak(){var n=Date.now(),f=function(o){return new Date(n-o*864e5).toISOString().slice(0,10)};return st.last===f(0)||st.last===f(1)?st.streak||0:0}
function touch(){var n=Date.now(),d=new Date(n).toISOString().slice(0,10);if(st.last===d)return;st.streak=streak()>0?(st.streak||0)+1:1;st.last=d}
function hero(){var t=0,n=0;S.forEach(function(s){var m=s.c.length+s.q.length;t+=prog(s)*m;n+=m});var v=Math.round(t/n),r=34,c=2*Math.PI*r;$('hero').innerHTML='<svg width="84" height="84" viewBox="0 0 84 84"><circle cx="42" cy="42" r="'+r+'" fill="none" stroke="var(--bd)" stroke-width="8"/><circle cx="42" cy="42" r="'+r+'" fill="none" stroke="var(--ac)" stroke-width="8" stroke-linecap="round" stroke-dasharray="'+c+'" stroke-dashoffset="'+c*(1-v/100)+'" transform="rotate(-90 42 42)"/><text x="42" y="48" text-anchor="middle" font-size="18" font-weight="800" fill="currentColor">'+v+'%</text></svg><div><b>تقدمك الكلي</b><div style="color:var(--mut);font-size:13px;margin-top:4px">🔥 '+streak()+' يوم متتالي</div><div style="color:var(--mut);font-size:13px">'+n+' عنصر مراجعة</div></div>'}
function rev(){var p=st.p[cur.id],h='';cur.c.forEach(function(c,i){if(p.c[i]===0)h+='<div class="ri">🃏 <b>'+c[0]+'</b><br>'+c[1]+'</div>'});cur.q.forEach(function(q,i){if(p.q[i]===0)h+='<div class="ri">📝 <b>'+q[0]+'</b><br>✔ '+q[1][0]+(q[2]?'<br>💡 '+q[2]:'')+'</div>'});$('pane').innerHTML=h?'<h2 style="font-size:16px;margin-bottom:4px">عناصر محتاجة مراجعة</h2>'+h:'<div class="big">🎉</div><p class="sub">مفيش حاجة للمراجعة دلوقتي!</p>'}
var st=null;try{st=JSON.parse(localStorage.getItem('sev1'))}catch(e){}
st=st||{name:'',theme:'auto',wel:true,p:{}};
function save(){try{localStorage.setItem('sev1',JSON.stringify(st))}catch(e){}}
function $(i){return document.getElementById(i)}
function show(id){document.querySelectorAll('.scr').forEach(function(s){s.classList.toggle('on',s.id===id)});if(id==='home')renderHome();window.scrollTo(0,0)}
function openM(i){$(i).classList.add('on');$('wc').checked=st.wel!==false;$('ex').value=''}
function closeM(i){$(i).classList.remove('on')}
function theme(){var r=document.documentElement;st.theme==='auto'?r.removeAttribute('data-theme'):r.setAttribute('data-theme',st.theme)}
function toggleTheme(){var d=document.documentElement.getAttribute('data-theme');var dark=d?d==='dark':matchMedia('(prefers-color-scheme: dark)').matches;st.theme=dark?'light':'dark';theme();save()}
function reg(){var n=$('nm').value.trim();if(!n){$('nm').focus();return}st.name=n;save();start()}
function start(){$('wn').textContent=st.name;$('hn').textContent=st.name;show(st.wel!==false?'wel':'home')}
function prog(s){var p=st.p[s.id]||{c:{},q:{}};var d=0;for(var k in p.c)if(p.c[k])d++;for(var k in p.q)if(p.q[k])d++;return Math.round(100*d/(s.c.length+s.q.length))}
function renderHome(){hero();$('subs').innerHTML=S.map(function(s,i){var v=prog(s);return '<div class="sj" style="border-top:4px solid '+C[i]+'" onclick="openS('+i+')"><div class="e">'+s.e+'</div><b>'+s.n+'</b><small>'+s.c.length+' بطاقات • '+s.q.length+' أسئلة</small><div class="bar"><i style="width:'+v+'%"></i></div><small>'+v+'%</small></div>'}).join('')}
var cur,md='c',ix=0,flip=false;
function openS(i){cur=S[i];st.p[cur.id]=st.p[cur.id]||{c:{},q:{}};$('st').textContent=cur.e+' '+cur.n;show('sub');mode('c')}
function mode(m){md=m;ix=0;flip=false;sc=0;$('t1').className=m==='c'?'on':'';$('t2').className=m==='q'?'on':'';$('t3').className=m==='r'?'on':'';m==='c'?card():m==='q'?quiz():rev()}
function card(){var c=cur.c[ix];$('pane').innerHTML='<div class="hint">بطاقة '+(ix+1)+' من '+cur.c.length+'</div><div class="fc'+(flip?' back':'')+'" onclick="flip=!flip;card()">'+(flip?c[1]:c[0])+'</div><div class="hint">اضغط على البطاقة لقلبها</div><div class="row"><button class="ok" onclick="mark(1)">✔ عرفتها</button><button class="bad" onclick="mark(0)">↻ راجعها</button></div>'}
function mark(v){st.p[cur.id].c[ix]=v;touch();save();flip=false;ix=(ix+1)%cur.c.length;card()}
function quiz(){if(ix>=cur.q.length){var ok=sc;$('pane').innerHTML='<div class="big">'+(ok==cur.q.length?'🏆':ok*2>=cur.q.length?'👏':'💪')+'</div><h2 style="text-align:center">انتهى الاختبار</h2><p class="sub">إجاباتك الصحيحة: '+ok+' من '+cur.q.length+'</p><button class="b" style="width:100%" onclick="mode(\'q\')">إعادة الاختبار</button>';return}
var q=cur.q[ix];var o=q[1].map(function(t,i){return[t,i]}).sort(function(){return Math.random()-.5});
